  "runtime": {
    "intro": "运行时状态是「参数之外、模型文件里没有、但推理时必须存在」的现场。",
    "groups": [
      {
        "key": "resident",
        "label": "常驻（启动后不动）",
        "items": [
          "参数 / 权重",
          "KV block pool",
          "workspace",
          "CUDA context / Graph"
