  "timeline": [
    {
      "id": "embed",
      "title": "token id → 向量",
      "op": "embedding 查表：从 [vocab, hidden] 里取一行",
      "shape": "[1, {hidden}]",
      "kernel": "gather / index_select",
      "worker": "GPU",
      "detail": "只读权重矩阵的一行（hidden 个数），不是读整张表；但整张表仍占显存。"
    },
    {
      "id": "qkv",
      "title": "QKV 投影（第一层）",
      "op": "hidden 乘三个权重矩阵",
      "shape": "Q [1, {q_dim}] · K/V [1, {kv_dim}]",
      "kernel": "GEMM / GEMV（cuBLAS）",
      "worker": "GPU",
      "detail": "decode 时 batch=1，GEMM 退化成 GEMV：算得不多，但要读权重——这是 decode 慢的主因。"
    },
    {
      "id": "rope",
      "title": "q_norm / k_norm + RoPE",
      "op": "按 head 做 RMSNorm，再按位置旋转 Q/K",
      "shape": "Q/K 形状不变",
      "kernel": "RMSNorm + elementwise（通常融合）",
      "worker": "GPU",
      "detail": "只改 Q/K 的数值，不产生新张量；模型定义公式，GPU 执行 kernel。"
    },
    {
      "id": "kvwrite",
      "title": "写入 KV cache",
      "op": "把这一步的 K/V 追加到该层缓存",
      "shape": "{kv_heads} × 1 × {head_dim}（每层）",
      "kernel": "copy / paged write",
      "worker": "引擎 + GPU",
      "detail": "张量在 GPU 显存；块怎么分、写到哪个物理块由引擎决定（paged attention 的 block table）。"
    },
    {
      "id": "attention",
      "title": "attention：读全部历史",
      "op": "当前 token 的 Q 对 T 个历史 K 做加权",
      "shape": "输出 [1, {q_dim}]",
      "kernel": "FlashAttention（融合 QKᵀ / softmax / PV）",
      "worker": "GPU",
      "detail": "decode 时 query 只有 1 个，但 key/value 有 T 个：计算量 O(T)，读取量 O(T)，是显存带宽问题。"
    },
    {
      "id": "oproj",
      "title": "o_proj + 残差",
      "op": "attention 输出投回 hidden，再加回残差流",
      "shape": "[1, {hidden}]",
      "kernel": "GEMM + add（elementwise）",
      "worker": "GPU",
      "detail": "残差保证每层看到的宽度始终是 hidden——这就是层数与维度没有绑定关系的原因。"
    },
    {
      "id": "moe",
      "title": "FFN / MoE：逐 token 变换",
      "op": "router 选 top-{top_k}，走 expert MLP",
      "shape": "router [1, {experts}] · 每个 expert {hidden}→{expert_inter}→{hidden}",
      "kernel": "GEMV/GEMM + topk + softmax + SiLU（grouped）",
      "worker": "模型 + GPU",
      "detail": "MoE 只读激活的 expert；dense 模型这一步读全部 FFN 权重。参数量在这里最大。"
    },
    {
      "id": "head",
      "title": "final norm + lm_head",
      "op": "最后一个位置的 hidden 投到词表",
      "shape": "[1, {vocab}]",
      "kernel": "GEMM/GEMV + softmax/topk/argmax",
      "worker": "GPU",
      "detail": "只对最后一个位置算 logits；采样也在 GPU 上完成（top-k / top-p / argmax）。"
    }
  ],
  "gpuLoad": [
    {
      "id": "disk",
      "title": "① 磁盘 / 网络",
      "detail": "safetensors（HF）或 GGUF（llama.cpp）文件。量化版本每个参数约 4–5 bit。",
      "sizeKey": "disk"
    },
    {
      "id": "ram",
      "title": "② CPU 内存",
      "detail": "读入或用 mmap 映射；容器/OS 的 page cache 也算在这里。这一站往往被忽略，但 30B 模型也要十几 GB 内存。",
      "sizeKey": "ram"
    },
    {
      "id": "h2d",
      "title": "③ H2D 拷贝",
      "detail": "cudaMemcpyAsync 经 PCIe/NVLink 送进显存，框架的加载器负责（不是模型）。PCIe 4.0 x16 约 25 GB/s。",
      "sizeKey": "h2d"
    },
    {
      "id": "vram",
      "title": "④ GPU 显存",
      "detail": "权重常驻显存，推理时只读；KV cache 和激活另外分配。量化格式决定显存占用。",
      "sizeKey": "vram"
    }
  ],
  "kernels": [
    {
      "stage": "embedding",
      "op": "token → 一行向量",
      "kernel": "gather / index_select",
      "prefill": "O(n)",
      "decode": "O(1)",
      "worker": "GPU"
    },
    {
      "stage": "QKV 投影",
      "op": "hidden × Wq/Wk/Wv",
