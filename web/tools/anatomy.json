{
  "quiz": [
    {
      "id": "a1",
      "tag": "层与维度",
      "q": "一个 48 层的模型，第 1 层和第 48 层的输出维度一样吗？",
      "options": [
        "不一样，逐层变小",
        "一样，都是 hidden 维度",
        "不知道，取决于层数"
      ],
      "answer": 1,
      "why": "层数加深不改变残差流宽度：每层输入输出都是 [n, hidden]。变的是每层新增的参数和计算，不是维度。"
    },
    {
      "id": "a2",
      "tag": "参数",
      "q": "生成一个 token 时，模型的参数被完整读了几遍？",
      "options": [
        "一遍，全部参数",
        "只读这一步用到的部分（MoE 只读 top-k expert）",
        "只读 embedding"
      ],
      "answer": 1,
      "why": "dense 模型每步要把全部权重扫一遍；MoE 每步只读激活的 expert 和共享部分。参数量决定显存，激活参数量决定每步读多少。"
    },
    {
      "id": "a3",
      "tag": "GPU 加载",
      "q": "权重从磁盘到 GPU 显存，中间经过哪些站？",
      "options": [
        "磁盘 → GPU 显存，一步到位",
        "磁盘 → CPU 内存 → H2D 拷贝 → GPU 显存",
        "磁盘 → 显存 → 内存"
      ],
      "answer": 1,
      "why": "先读进 host 内存（或 mmap），再由框架用 cudaMemcpyAsync 送到显存；量化格式还会在加载时反量化，或在 kernel 里边算边反量化。"
    },
    {
      "id": "a4",
      "tag": "GPU kernel",
      "q": "decode 生成一个 token，GPU 上最重的两类 kernel 是什么？",
      "options": [
        "embedding 查表 + softmax",
        "GEMM/GEMV 读权重 + attention 读历史 KV",
        "只跑 attention，不跑矩阵乘"
      ],
      "answer": 1,
      "why": "decode 是带宽受限：每步读激活权重和全部历史 K/V；prefill 才是大 GEMM 的计算受限。"
    }
  ],
